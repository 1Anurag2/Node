<%- include('header') %>

<div class="container text-center">
  <div class="row">
    <div class="col-6">
      <h1><%= message %></h1>
      <table class="ms-4" border="2"; width=500px>
        <% items.forEach(element => { %>
        <tr>
          <td><%= element.Name %></td>
          <td><%= element.Age %></td>
          <td><%= element.city %></td>
        </tr>
        <% }) %>
      </table>
    </div>
    <div class="col-6">
      <img
        src="Images/god.png"
        style="width: 200px; height: auto; border-radius: 50px; margin: 60px"
        alt=""
      />
    </div>
  </div>
</div>

<%- include('footer') %>
